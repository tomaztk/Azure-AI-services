// Invoice intake + data agent demo: everything the demo needs, created by `azd up`.
targetScope = 'subscription'

@minLength(1)
@maxLength(40)
@description('Name of the azd environment. Used to name the resource group and tag resources.')
param environmentName string

// Content Understanding is only available in these regions.
@allowed([
  'swedencentral'
  'westeurope'
  'uksouth'
  'eastus'
  'eastus2'
  'westus'
  'westus3'
  'southcentralus'
  'canadacentral'
  'australiaeast'
  'japaneast'
  'southeastasia'
])
@metadata({ azd: { type: 'location' } })
@description('Region for all resources. Must support Content Understanding.')
param location string

@description('Object ID of the person running azd. Gets SQL admin and data-plane roles so the setup scripts work.')
param principalId string = ''

@description('Display name / UPN of the person running azd. Only used as the SQL Entra admin label.')
param principalName string = ''

@allowed([ 'User', 'ServicePrincipal' ])
param principalType string = 'User'

// ---------- Models ----------
@description('Model used by the data agent and by Content Understanding field extraction.')
param chatModelName string = 'gpt-5.2'
param chatModelVersion string = '2025-12-11'
param chatModelCapacity int = 100

param embeddingModelName string = 'text-embedding-3-large'
param embeddingModelVersion string = '1'
param embeddingModelCapacity int = 100

@allowed([ 'GlobalStandard', 'DataZoneStandard', 'Standard' ])
param modelSkuName string = 'GlobalStandard'

// ---------- App ----------
@description('App Service plan SKU. B2 is fine for rehearsals; scale to P1v3 for the event.')
param appServiceSku string = 'B2'

@secure()
@description('Key that protects the presenter screen. Generated by the preprovision hook if empty.')
param presenterKey string = ''

param autoApproveMaxAmount string = '5000'
param minFieldConfidence string = '0.50'

// ---------- SQL ----------
@description('Max vCores for the serverless database.')
param sqlMaxVCores int = 2

@description('Auto-pause delay in minutes (-1 disables auto-pause). The first request after a pause takes about a minute.')
param sqlAutoPauseDelay int = 60

var resourceToken = toLower(uniqueString(subscription().id, environmentName, location))
var tags = { 'azd-env-name': environmentName, demo: 'foundry-invoice-intake' }

var foundryAccountName = 'aif-${resourceToken}'
var foundryProjectName = 'invoice-demo'
var chatDeploymentName = chatModelName
var embeddingDeploymentName = embeddingModelName
var webAppName = 'app-${resourceToken}'
var sqlDatabaseName = 'invoicedemo'

resource rg 'Microsoft.Resources/resourceGroups@2024-03-01' = {
  name: 'rg-${environmentName}'
  location: location
  tags: tags
}

module monitoring 'modules/monitoring.bicep' = {
  name: 'monitoring'
  scope: rg
  params: {
    location: location
    tags: tags
    logAnalyticsName: 'log-${resourceToken}'
    appInsightsName: 'appi-${resourceToken}'
  }
}

module storage 'modules/storage.bicep' = {
  name: 'storage'
  scope: rg
  params: {
    location: location
    tags: tags
    name: 'st${resourceToken}'
  }
}

module foundry 'modules/foundry.bicep' = {
  name: 'foundry'
  scope: rg
  params: {
    location: location
    tags: tags
    name: foundryAccountName
    projectName: foundryProjectName
    deployments: [
      {
        name: chatDeploymentName
        model: { format: 'OpenAI', name: chatModelName, version: chatModelVersion }
        sku: { name: modelSkuName, capacity: chatModelCapacity }
      }
      {
        name: embeddingDeploymentName
        model: { format: 'OpenAI', name: embeddingModelName, version: embeddingModelVersion }
        sku: { name: modelSkuName, capacity: embeddingModelCapacity }
      }
    ]
  }
}

module sql 'modules/sql.bicep' = {
  name: 'sql'
  scope: rg
  params: {
    location: location
    tags: tags
    serverName: 'sql-${resourceToken}'
    databaseName: sqlDatabaseName
    adminPrincipalId: principalId
    adminLogin: empty(principalName) ? 'entra-admin' : principalName
    adminPrincipalType: principalType == 'User' ? 'User' : 'Application'
    maxVCores: sqlMaxVCores
    autoPauseDelay: sqlAutoPauseDelay
  }
}

module web 'modules/web.bicep' = {
  name: 'web'
  scope: rg
  params: {
    location: location
    tags: tags
    name: webAppName
    planName: 'plan-${resourceToken}'
    skuName: appServiceSku
    appSettings: {
      FOUNDRY_ACCOUNT_ENDPOINT: foundry.outputs.endpoint
      FOUNDRY_PROJECT_ENDPOINT: foundry.outputs.projectEndpoint
      CHAT_DEPLOYMENT_NAME: chatDeploymentName
      AGENT_NAME: 'invoice-data-agent'
      SQL_SERVER: sql.outputs.serverFqdn
      SQL_DATABASE: sqlDatabaseName
      SQL_AUTHENTICATION: 'ActiveDirectoryMSI'
      STORAGE_ACCOUNT_URL: storage.outputs.blobEndpoint
      AUTO_APPROVE_MAX_AMOUNT: autoApproveMaxAmount
      MIN_FIELD_CONFIDENCE: minFieldConfidence
      PRESENTER_KEY: presenterKey
      APPLICATIONINSIGHTS_CONNECTION_STRING: monitoring.outputs.appInsightsConnectionString
    }
  }
}

// Data-plane roles for the web app's managed identity and for you (so the setup scripts run locally).
module roles 'modules/roles.bicep' = {
  name: 'roles'
  scope: rg
  params: {
    foundryAccountName: foundry.outputs.name
    storageAccountName: storage.outputs.name
    principals: concat(
      [ { id: web.outputs.principalId, type: 'ServicePrincipal' } ],
      empty(principalId) ? [] : [ { id: principalId, type: principalType } ]
    )
  }
}

// ---------- Outputs (azd writes these to .azure/<env>/.env) ----------
output AZURE_LOCATION string = location
output AZURE_TENANT_ID string = tenant().tenantId
output AZURE_RESOURCE_GROUP string = rg.name

output FOUNDRY_ACCOUNT_NAME string = foundry.outputs.name
output FOUNDRY_ACCOUNT_ENDPOINT string = foundry.outputs.endpoint
output FOUNDRY_PROJECT_NAME string = foundryProjectName
output FOUNDRY_PROJECT_ENDPOINT string = foundry.outputs.projectEndpoint
output CHAT_DEPLOYMENT_NAME string = chatDeploymentName
output CHAT_MODEL_NAME string = chatModelName
output EMBEDDING_DEPLOYMENT_NAME string = embeddingDeploymentName
output EMBEDDING_MODEL_NAME string = embeddingModelName
output AGENT_NAME string = 'invoice-data-agent'

output SQL_SERVER_NAME string = sql.outputs.serverName
output SQL_SERVER string = sql.outputs.serverFqdn
output SQL_DATABASE string = sqlDatabaseName

output STORAGE_ACCOUNT_NAME string = storage.outputs.name
output STORAGE_ACCOUNT_URL string = storage.outputs.blobEndpoint

output WEB_APP_NAME string = web.outputs.name
output WEB_APP_URL string = web.outputs.uri
output WEB_APP_PRINCIPAL_ID string = web.outputs.principalId

output APPLICATIONINSIGHTS_CONNECTION_STRING string = monitoring.outputs.appInsightsConnectionString
output AUTO_APPROVE_MAX_AMOUNT string = autoApproveMaxAmount
output MIN_FIELD_CONFIDENCE string = minFieldConfidence
